<?php
/**
 * Quick look at one resource, loaded into the popup.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation|null $resource
 * @var int $id
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
if (!$resource): ?>
<div class="bv-peek-body"><p class="bv-note"><?php echo sprintf($translate('Resource #%d cannot be read (deleted, or not visible to you).'), $id); ?></p></div>
<?php return; endif;
$media = $resource instanceof \Omeka\Api\Representation\ItemRepresentation ? $resource->media() : [];
$large = $resource->thumbnailDisplayUrl('large');
$template = $resource->resourceTemplate();
$class = $resource->resourceClass();
?>
<div class="bv-peek-head">
    <div>
        <h2><?php echo $escape($resource->displayTitle()); ?></h2>
        <div class="bv-muted">
            #<?php echo (int) $resource->id(); ?>
            <?php if ($template): ?> · <?php echo $escape($template->label()); ?><?php endif; ?>
            <?php if ($class): ?> · <?php echo $escape($translate($class->label())); ?><?php endif; ?>
            · <?php echo $resource->isPublic() ? $escape($translate('Public')) : '<span class="bv-flag bv-flag-private">' . $escape($translate('Private')) . '</span>'; ?>
        </div>
    </div>
    <div class="bv-peek-actions">
        <?php echo $this->hyperlink($translate('Open'), $resource->adminUrl(), ['target' => '_blank', 'class' => 'button']); ?>
        <?php if ($resource->userIsAllowed('update')): ?><?php echo $this->hyperlink($translate('Edit'), $resource->adminUrl('edit'), ['target' => '_blank', 'class' => 'button']); ?><?php endif; ?>
    </div>
</div>
<div class="bv-peek-body">
    <div class="bv-peek-media">
        <?php if ($large): ?>
        <img class="bv-peek-image" src="<?php echo $escapeAttr($large); ?>" alt="">
        <?php else: ?>
        <div class="bv-peek-noimage o-icon-items"></div>
        <?php endif; ?>
        <?php if (count($media) > 1): ?>
        <div class="bv-peek-strip">
            <?php foreach (array_slice($media, 0, 40) as $m): ?>
            <?php $sq = $m->thumbnailDisplayUrl('square'); $lg = $m->thumbnailDisplayUrl('large'); if (!$sq) continue; ?>
            <button type="button" class="bv-peek-thumb<?php echo $m->isPublic() ? '' : ' bv-peek-private'; ?>" data-large="<?php echo $escapeAttr($lg); ?>" title="<?php echo $escapeAttr($m->displayTitle() . ($m->isPublic() ? '' : ' (' . $translate('Private') . ')')); ?>"><img src="<?php echo $escapeAttr($sq); ?>" alt=""><?php if (!$m->isPublic()): ?><span class="bv-peek-private-mark o-icon-private" aria-label="<?php echo $escapeAttr($translate('Private')); ?>"></span><?php endif; ?></button>
            <?php endforeach; ?>
        </div>
        <?php if (count($media) > 40): ?><p class="bv-muted"><?php echo sprintf($translate('%d media in all.'), count($media)); ?></p><?php endif; ?>
        <?php endif; ?>
    </div>
    <div class="bv-peek-values">
        <?php
        // Private values: Omeka shows a small eye; say it in words too.
        echo preg_replace(
            '~(<span class="o-icon-private"[^>]*></span>)~',
            '$1 <span class="bv-flag bv-flag-private">' . $escape($translate('Private')) . '</span>',
            $resource->displayValues()
        );
        ?>
        <?php if ($resource instanceof \Omeka\Api\Representation\ItemRepresentation && $resource->itemSets()): ?>
        <div class="property">
            <h4><?php echo $translate('Item sets'); ?></h4>
            <div class="values"><?php foreach ($resource->itemSets() as $set): ?><div class="value"><?php echo $set->link($set->displayTitle(), null, ['target' => '_blank']); ?></div><?php endforeach; ?></div>
        </div>
        <?php endif; ?>
    </div>
</div>
