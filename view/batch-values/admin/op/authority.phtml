<?php
$translate = $this->plugin('translate');
$bv = $this->plugin('batchValuesRender');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$hasSuggest = \BatchValues\Stdlib\Authority::hasValueSuggest();
?>
<h4><?php echo $translate('1. Values'); ?><?php echo $bv->second('1. Values'); ?></h4>
<?php echo $this->partial('common/bv-picker', ['allProperties' => $allProperties ?? false, 'matchTypes' => $matchTypes ?? [], 'presetTypes' => $presetTypes ?? [], 'distinct' => $distinct, 'required' => [], 'pickerAllDefault' => true]); ?>
<h4><?php echo $translate('2. What to fill'); ?><?php echo $bv->second('2. What to fill'); ?></h4>
<div class="bv-radios bv-mode-choice">
    <label><input type="radio" name="authority_mode" value="label_missing" checked> <?php echo $translate('Fill empty labels from the link'); ?><?php echo $bv->second('Fill empty labels from the link'); ?>
        <?php echo $this->partial('common/bv-q', ['text' => $translate('Links (URI or Value Suggest) whose label is empty or is the link itself get the name the authority gives them. Other links are left alone.')]); ?></label>
    <label><input type="radio" name="authority_mode" value="label_all"> <?php echo $translate('Set every label to the authority’s name'); ?><?php echo $bv->second('Set every label to the authority’s name'); ?>
