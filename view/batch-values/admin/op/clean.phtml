// "Fix" of the checks: only the options found (comma separated).
$only = isset($presetOnly) ? array_filter(explode(',', (string) $presetOnly)) : [];
$on = function (string $name, bool $default) use ($only) {
    return (!$only ? $default : in_array($name, $only, true)) ? ' checked' : '';
};
